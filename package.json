{
  "name": "@etsme/ffmpeg-mp4-player",
  "version": "1.0.0",
  "description": "Web video player powered by ffmpeg with MSE streaming (embeddable npm package)",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ffmpeg-mp4-player": "./dist/bin.cjs"
  },
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/bin.cjs",
    "build": "vite build && vite build -c vite.config.child.ts && vite build -c vite.config.bin.ts && vite build -c vite.config.client.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@typescript/typescript6": "^6.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "release-it": "^21.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  }
}
